<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_full_year" model="ir.ui.view">
        <field name="name">hr.leave.view.form.full.year</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='full_date']" position="attributes">
                <attribute name="class" add="flex-wrap gap-1" separator=" "/>
            </xpath>
            <xpath expr="//div[@id='full_date']/field[@name='request_date_from']" position="attributes">
                <attribute name="class" add="flex-shrink-0" separator=" "/>
                <attribute name="style">min-width: max-content;</attribute>
            </xpath>
            <xpath expr="//div[@id='full_date']/div" position="attributes">
                <attribute name="style">min-width: max-content;</attribute>
            </xpath>
        </field>
    </record>
    <record id="hr_leave_view_kanban_full_year" model="ir.ui.view">
        <field name="name">hr.leave.view.kanban.full.year</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[contains(@t-out, 'request_date_from.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_from.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_from.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_from.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_to.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_to.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_to.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_to.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_to.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//t[contains(@t-out, 'request_date_to.raw_value') and not(contains(@t-out, 'year:'))]" position="attributes">
                <attribute name="t-out">luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_value')]/div[hasclass('o_hr_holidays_card')][1]" position="attributes">
                <attribute name="class" remove="col-4" add="col-3" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_value')]/div[hasclass('o_hr_holidays_name')]" position="attributes">
                <attribute name="class" remove="col-2" add="col-3" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_name')]/div[hasclass('d-flex')]" position="attributes">
                <attribute name="class" remove="d-flex flex-row" add="d-block" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_name')]//t[contains(@t-out, 'request_date_from.raw_value')]" position="replace">
                <span class="text-nowrap" t-out="luxon.DateTime.fromISO(record.request_date_from.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })"/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_name')]//t[contains(@t-out, 'request_date_to.raw_value')]" position="replace">
                <span class="text-nowrap" t-out="luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })"/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_name')]//t[contains(@t-out, 'request_date_to.raw_value')]" position="replace">
                <span class="text-nowrap" t-out="luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })"/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_name')]//t[contains(@t-out, 'request_date_to.raw_value')]" position="replace">
                <span class="text-nowrap" t-out="luxon.DateTime.fromISO(record.request_date_to.raw_value).toLocaleString({ year: 'numeric', month: 'short', day: 'numeric' })"/>
            </xpath>
            <xpath expr="//div[@id='date_part']" position="attributes">
                <attribute name="class" remove="d-flex flex-row" add="d-block" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
