<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_invoice_inbound" model="ir.module.category">
        <field name="name">Invoice Inbox</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_invoice_inbound" model="res.groups.privilege">
        <field name="name">Invoice Inbox</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_invoice_inbound"/>
    </record>

    <record id="group_invoice_inbound_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_invoice_inbound"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_invoice_inbound_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_invoice_inbound"/>
        <field name="implied_ids" eval="[(4, ref('group_invoice_inbound_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
