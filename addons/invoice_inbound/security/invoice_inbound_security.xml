<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- No groups: the rules apply to everyone, managers included. -->
        <record id="invoice_inbound_company_rule" model="ir.rule">
            <field name="name">Inbound Invoice: multi-company</field>
            <field name="model_id" ref="model_invoice_inbound"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="invoice_inbound_line_company_rule" model="ir.rule">
            <field name="name">Inbound Invoice Line: multi-company</field>
            <field name="model_id" ref="model_invoice_inbound_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
