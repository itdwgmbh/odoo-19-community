<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_invoice_inbound_fetch" model="ir.cron">
            <field name="name">Invoice Inbox: Fetch Mailbox</field>
            <field name="model_id" ref="model_invoice_inbound"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_mailbox()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_invoice_inbound_extract" model="ir.cron">
            <field name="name">Invoice Inbox: Extract Fields</field>
            <field name="model_id" ref="model_invoice_inbound"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_extract()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
