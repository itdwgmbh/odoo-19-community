<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.itdw.api.jwt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="API Authentication" name="itdw_api_jwt" groups="base.group_system"
                     logo="/itdw_api_jwt/static/description/icon.png">
                    <block title="Authentication">
                        <setting id="api_jwt_issuers_setting" string="Trusted JWT issuers"
                                 help="Configure issuers, their signing keys and the claim holding the Odoo login.">
                            <button name="%(itdw_api_jwt.action_api_jwt_issuer)d" type="action"
                                    string="Manage issuers" class="btn-link"/>
                        </setting>
                        <setting id="api_jwt_only_setting" string="Require JWTs for bearer routes"
                                 help="Reject API keys and browser sessions on routes that use bearer authentication.">
                            <field name="api_jwt_only"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
